# ============================================================
# Agentic Data Preprocessing — Ortam Değişkenleri Şablonu
# Bu dosyayı .env olarak kopyala ve değerleri doldur.
# .env dosyası .gitignore ile repository'den dışlanmıştır.
# ============================================================

# SQLite veritabanı dosya yolu (proje kökünden göreli veya mutlak)
DB_PATH=agentic_preprocessing.db

# JWT imzalama anahtarı — üretimde güçlü, rastgele bir değer kullan:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_before_production

# JWT token geçerlilik süresi (dakika)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------------
# LLM yapılandırması
# ---------------------------------------------------------------------------

# Sağlayıcı: 'stub' (varsayılan, gerçek API yok) veya 'openai'
# LLM_PROVIDER=stub

# Model adı (sağlayıcıya göre değişir)
# LLM_MODEL=gpt-4o-mini

# API anahtarı — asla repository'e ekleme
# LLM_API_KEY=sk-...

# Özel API endpoint (OpenAI-uyumlu proxy için, isteğe bağlı)
# LLM_BASE_URL=https://api.openai.com/v1

# İstek zaman aşımı süresi (saniye, varsayılan: 30.0)
# LLM_TIMEOUT_SECONDS=30.0

# Geçici hatalarda maksimum yeniden deneme sayısı (varsayılan: 2)
# LLM_MAX_RETRIES=2

# Yeniden denemeler tükenince StubLLMClient'e düş (varsayılan: false)
# LLM_FALLBACK_ENABLED=false
